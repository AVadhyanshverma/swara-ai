/* ============================================================
   REVERIE — Dark Glassmorphism Design System
   Palette derived from black-hole accretion disk wallpaper:
   deep space blacks, warm amber, cool silver, violet accents.
   ============================================================ */

/* ---- 1. Design Tokens ---- */
:root {
  /* Accent colours */
  --accent:          #c084fc;
  --accent-hover:    #d8b4fe;
  --accent-dim:      rgba(192, 132, 252, 0.12);
  --amber:           #f59e0b;
  --amber-dim:       rgba(245, 158, 11, 0.10);
  --cyan:            #22d3ee;
  --gradient:        linear-gradient(135deg, #c084fc 0%, #f59e0b 100%);
  --gradient-subtle: linear-gradient(135deg, rgba(192,132,252,0.25), rgba(245,158,11,0.15));
  --danger:          #f87171;
  --danger-dim:      rgba(248, 113, 113, 0.12);
  --success:         #34d399;

  /* Glass surfaces */
  --glass-bg:        rgba(10, 8, 18, 0.62);
  --glass-bg-heavy:  rgba(6, 5, 14, 0.82);
  --glass-border:    rgba(255, 255, 255, 0.07);
  --glass-border-h:  rgba(255, 255, 255, 0.14);
  --blur:            6px;
  --blur-heavy:      10px;

  /* Text */
  --t1: #f1f5f9;
  --t2: #a1a1aa;
  --t3: #636370;

  /* Radii */
  --r-sm:  8px;
  --r-md:  12px;
  --r-lg:  16px;
  --r-xl:  20px;
  --r-2xl: 24px;
  --r-full:9999px;

  /* Layout */
  --sidebar-w: 272px;

  /* Shadows */
  --sh-sm:   0 2px 8px rgba(0,0,0,.25);
  --sh-md:   0 8px 24px rgba(0,0,0,.35);
  --sh-lg:   0 16px 48px rgba(0,0,0,.45);
  --sh-glow: 0 0 24px rgba(192,132,252,.15);

  /* Motion */
  --ease: cubic-bezier(.4,0,.2,1);
  --dur:  .2s;
}

/* ---- 2. Reset & Base ---- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
::selection{background:rgba(192,132,252,.3);color:#fff}

html,body{
  height:100%;overflow:hidden;
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
  font-size:14px;line-height:1.6;color:var(--t1);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

a{color:var(--accent-hover);text-decoration:none}
button{font-family:inherit}
svg{display:inline-block;vertical-align:middle;flex-shrink:0}

/* ---- 3. Background Layers ---- */
#bg-layer{
  position:fixed;inset:0;z-index:-2;
  background:url('/static/img/bg.jpeg') center/cover no-repeat;
  transform:scale(1.0);
  filter: blur(2px);
}

#bg-overlay{
  position:fixed;inset:0;z-index:-1;
  background: rgba(0, 0, 0, 0.5); /* Fade overlay */
}

/* ---- 4. App Shell ---- */
#app{display:flex;height:100vh;width:100vw}

/* ---- 5. Sidebar ---- */
#sidebar{
  width:var(--sidebar-w);min-width:180px;max-width:600px;
  position:relative;
  background:var(--glass-bg-heavy);
  backdrop-filter:blur(var(--blur-heavy));-webkit-backdrop-filter:blur(var(--blur-heavy));
  border-right:1px solid var(--glass-border);
  display:flex;flex-direction:column;z-index:10;
  transition: margin-left var(--dur) var(--ease);
}
#sidebar.collapsed {
  margin-left: calc(-1 * var(--sidebar-w));
}
#sidebar.is-resizing {
  transition: none !important;
  user-select: none;
}

/* — header */
.sidebar-header{
  padding:20px 16px;display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--glass-border);
}
.brand{display:flex;align-items:center;gap:10px}
.brand-icon{width:30px;height:30px;flex-shrink:0}
.brand-name{
  font-size:17px;font-weight:700;letter-spacing:-.02em;
  background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}

.btn-icon{
  display:flex;align-items:center;justify-content:center;
  width:34px;height:34px;border:1px solid var(--glass-border);border-radius:var(--r-md);
  background:rgba(255,255,255,.04);color:var(--t2);cursor:pointer;
  transition:all var(--dur) var(--ease);
}
.btn-icon:hover{background:var(--accent-dim);border-color:rgba(192,132,252,.3);color:var(--accent-hover)}
.btn-icon svg{width:18px;height:18px}

/* — search */
.sidebar-search{padding:12px 12px 6px}
.search-box{
  display:flex;align-items:center;gap:8px;padding:7px 12px;
  background:rgba(255,255,255,.03);border:1px solid var(--glass-border);border-radius:var(--r-md);
  transition:border-color var(--dur) var(--ease);
}
.search-box:focus-within{border-color:rgba(192,132,252,.3)}
.search-box svg{width:15px;height:15px;color:var(--t3);flex-shrink:0}
.search-box input{
  flex:1;background:transparent;border:none;color:var(--t1);font-size:12.5px;outline:none;font-family:inherit;
}
.search-box input::placeholder{color:var(--t3)}

/* ---- 6. Thread List ---- */
.thread-list{flex:1;overflow-y:auto;padding:6px 0}

.thread-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 12px;margin:2px 8px;
  border-radius:var(--r-md);cursor:pointer;
  border:1px solid transparent;
  transition:all var(--dur) var(--ease);
  position:relative;
}
.thread-item:hover{background:rgba(255,255,255,.04);border-color:var(--glass-border)}
.thread-item.active{background:var(--accent-dim);border-color:rgba(192,132,252,.22)}

.thread-icon{width:16px;height:16px;color:var(--t3);flex-shrink:0}
.thread-item.active .thread-icon{color:var(--accent)}

.thread-title{
  flex:1;font-size:13px;color:var(--t2);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.thread-item.active .thread-title{color:var(--t1)}

.thread-delete{
  opacity:0;width:24px;height:24px;display:flex;align-items:center;justify-content:center;
  border:none;background:transparent;color:var(--t3);cursor:pointer;
  border-radius:var(--r-sm);transition:all var(--dur) var(--ease);flex-shrink:0;
}
.thread-item:hover .thread-delete{opacity:1}
.thread-delete:hover{background:var(--danger-dim);color:var(--danger)}
.thread-delete svg{width:14px;height:14px}

/* — footer */
.sidebar-footer{padding:12px 12px;border-top:1px solid var(--glass-border)}
.status-badge{
  display:flex;align-items:center;gap:8px;
  padding:7px 12px;
  background:rgba(52,211,153,.06);border:1px solid rgba(52,211,153,.12);
  border-radius:var(--r-full);font-size:11px;color:#6ee7b7;font-weight:500;
}
.status-dot{
  width:6px;height:6px;border-radius:50%;background:#34d399;
  animation:pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:.35}}
.status-badge svg{width:12px;height:12px}

/* ---- 7. Main Content ---- */
#main-area{
  flex:1;display:flex;flex-direction:column;
  position:relative;overflow:hidden;min-width:0;
}

#sidebar-toggle-btn {
  position: absolute; top: 12px; left: 16px; z-index: 40;
  background: transparent; border: none;
  color: var(--t2); width: 34px; height: 34px;
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all var(--dur) var(--ease);
}
#sidebar-toggle-btn:hover { background: rgba(255,255,255,0.06); color: var(--t1); }
#sidebar-toggle-btn svg { width: 20px; height: 20px; }

/* ---- 8. Welcome Screen ---- */
#welcome-screen{
  flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:40px 24px;text-align:center;
}
#welcome-screen.hidden{display:none}

.welcome-logo{
  width:80px;height:80px;color:var(--accent);margin-bottom:20px;
  filter:drop-shadow(0 0 28px rgba(192,132,252,.35));
  animation:float 6s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

.welcome-title{
  font-size:38px;font-weight:800;letter-spacing:-.03em;
  background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  margin-bottom:8px;
}
.welcome-sub{font-size:14.5px;color:var(--t3);max-width:420px;margin-bottom:36px}

/* Feature pills */
.welcome-pills{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:40px;max-width:520px}
.pill{
  display:flex;align-items:center;gap:6px;padding:6px 14px;
  background:rgba(0,0,0,0.45);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border:1px solid rgba(255,255,255,0.08);
  border-radius:var(--r-full);font-size:12px;color:var(--t2);
  transition:all var(--dur) var(--ease);cursor:default;
}
.pill svg{width:13px;height:13px;color:var(--accent)}
.pill:hover{background:rgba(192,132,252,0.15);border-color:rgba(192,132,252,.35);color:var(--t1)}

/* Quick-action & Suggestion cards */
.suggestions-grid{
  display:grid;grid-template-columns:repeat(2,minmax(240px,1fr));gap:12px;
  max-width:680px;width:100%;margin-bottom:20px;
}
.suggestion-card{
  display:flex;flex-direction:column;align-items:flex-start;gap:6px;
  padding:14px 16px;background:var(--glass-bg);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border:1px solid var(--glass-border);border-radius:var(--r-lg);
  cursor:pointer;transition:all var(--dur) var(--ease);text-align:left;
}
.suggestion-card:hover{
  background:var(--accent-dim);border-color:rgba(192,132,252,.3);
  transform:translateY(-2px);box-shadow:var(--sh-sm);
}
.card-icon{
  display:flex;align-items:center;justify-content:center;
  width:32px;height:32px;border-radius:var(--r-md);
  background:rgba(255,255,255,.05);margin-bottom:4px;
}
.card-icon svg{width:18px;height:18px;color:var(--accent);flex-shrink:0}
.card-title{font-size:13.5px;font-weight:600;color:var(--t1)}
.card-desc{font-size:12px;color:var(--t3);line-height:1.4}

.quick-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;max-width:600px;margin-bottom:8px}
.quick-card{
  display:flex;align-items:center;gap:8px;padding:10px 18px;
  background:var(--glass-bg);backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border:1px solid var(--glass-border);border-radius:var(--r-lg);
  font-size:13px;color:var(--t2);cursor:pointer;
  transition:all var(--dur) var(--ease);
}
.quick-card:hover{background:var(--accent-dim);border-color:rgba(192,132,252,.3);color:var(--t1);transform:translateY(-2px)}
.quick-card svg{width:16px;height:16px;color:var(--amber)}

/* ---- 9. Chat Area ---- */
#chat-area{flex:1;display:flex;flex-direction:column;overflow:hidden}
#chat-area.hidden{display:none}

.chat-header{
  padding:12px 24px 12px 64px;
  background:rgba(8,6,16,.55);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--glass-border);
  display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
}
.chat-header-title{font-size:14px;font-weight:600;color:var(--t1)}
.model-badge{
  display:flex;align-items:center;gap:5px;padding:3px 10px;
  background:var(--accent-dim);border:1px solid rgba(192,132,252,.18);
  border-radius:var(--r-full);font-size:10.5px;color:var(--accent-hover);font-weight:600;
  text-transform:uppercase;letter-spacing:.04em;
}
.model-badge svg{width:12px;height:12px}

/* ---- 10. Chat Container & Messages ---- */
#chat-container{
  flex:1;overflow-y:auto;padding:24px;
  display:flex;flex-direction:column;gap:14px;
  scroll-behavior:smooth;
}

.message{
  max-width:780px;width:100%;margin:0 auto;
  padding:16px 20px;border-radius:var(--r-lg);
  line-height:1.7;word-wrap:break-word;
  animation:msg-in .35s var(--ease) both;
}
@keyframes msg-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

.user-message{
  background:linear-gradient(135deg, rgba(192,132,252,.1), rgba(245,158,11,.06));
  border:1px solid rgba(192,132,252,.14);
  border-radius:var(--r-lg) var(--r-lg) var(--r-sm) var(--r-lg);
}
.assistant-message{
  background:rgba(255,255,255,.02);
  border:1px solid rgba(255,255,255,.04);
  border-radius:var(--r-lg) var(--r-lg) var(--r-lg) var(--r-sm);
}

/* — Message typography */
.message h1,.message h2,.message h3,.message h4{margin:14px 0 6px;color:var(--t1)}
.message h1{font-size:1.35em} .message h2{font-size:1.2em}
.message h3{font-size:1.08em} .message h4{font-size:1em}
.message p{margin-bottom:10px} .message p:last-child{margin-bottom:0}
.message ul,.message ol{padding-left:20px;margin-bottom:10px}
.message li{margin-bottom:3px}
.message strong{color:var(--t1);font-weight:600}
.message em{color:var(--t2)}
.message a{color:var(--accent-hover);border-bottom:1px solid rgba(192,132,252,.25);transition:border-color var(--dur)}
.message a:hover{border-color:var(--accent-hover)}

.message table{width:100%;border-collapse:collapse;margin:12px 0;font-size:13px}
.message th,.message td{padding:8px 12px;border:1px solid var(--glass-border);text-align:left}
.message th{background:rgba(255,255,255,.04);font-weight:600;color:var(--t1)}

.message blockquote{
  border-left:3px solid var(--accent);padding:8px 14px;margin:12px 0;
  color:var(--t2);background:rgba(192,132,252,.04);border-radius:0 var(--r-sm) var(--r-sm) 0;
}
.message hr{border:none;border-top:1px solid var(--glass-border);margin:16px 0}
.message img{max-width:100%;border-radius:var(--r-md);margin:8px 0}

/* — Code */
.message pre{
  background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.06);
  border-radius:var(--r-md);padding:14px 18px;overflow-x:auto;
  margin:12px 0;font-size:13px;line-height:1.55;
}
.message pre code{
  background:transparent;padding:0;border-radius:0;border:none;
  font-family:'JetBrains Mono','Fira Code','Cascadia Code','Consolas',monospace;color:#e2e8f0;
}
.message code{
  background:rgba(192,132,252,.1);border:1px solid rgba(192,132,252,.08);
  border-radius:5px;padding:2px 7px;font-size:.87em;
  font-family:'JetBrains Mono','Fira Code',monospace;color:var(--accent-hover);
}

/* ---- 11. Think Blocks ---- */
.think-block{
  background:rgba(0,0,0,0.6);border:1px solid rgba(245,158,11,.1);
  border-radius:var(--r-md);margin:12px 0;overflow:hidden;
}
.think-block summary{
  padding:10px 14px;cursor:pointer;font-size:12px;font-weight:600;
  color:var(--t3);display:flex;align-items:center;gap:8px;
  user-select:none;list-style:none;transition:color var(--dur) var(--ease);
}
.think-block summary::-webkit-details-marker{display:none}
.think-block summary:hover{color:var(--amber)}
.think-block summary svg{width:14px;height:14px;color:var(--amber)}
.think-block[open] summary{border-bottom:1px solid rgba(245,158,11,.08)}
.think-content{
  padding:12px 14px;font-size:12px;
  font-family:'JetBrains Mono',monospace;color:var(--t3);
  line-height:1.65;max-height:300px;overflow-y:auto;
}

/* ---- 12. Input Area ---- */
#input-area{
  padding:14px 24px 18px;display:flex;flex-direction:column;align-items:center;flex-shrink:0;
}

#input-wrapper{
  display:flex;align-items:flex-end;width:100%;max-width:780px;
  background:rgba(12,10,24,.55);
  backdrop-filter:blur(var(--blur));-webkit-backdrop-filter:blur(var(--blur));
  border:1px solid var(--glass-border);border-radius:var(--r-xl);
  padding:6px;transition:all .3s var(--ease);box-shadow:var(--sh-md);
}
#input-wrapper:focus-within{
  border-color:rgba(192,132,252,.3);
  box-shadow:var(--sh-md), var(--sh-glow);
}

#chat-input{
  flex:1;border:none;padding:10px 14px;font-size:14px;
  background:transparent;color:var(--t1);resize:none;outline:none;
  max-height:180px;min-height:22px;line-height:1.5;font-family:inherit;
}
#chat-input::placeholder{color:var(--t3)}

#send-btn{
  display:flex;align-items:center;justify-content:center;
  width:38px;height:38px;border:none;border-radius:var(--r-md);
  background:var(--gradient);color:#fff;cursor:pointer;flex-shrink:0;
  transition:all var(--dur) var(--ease);
}
#send-btn:hover:not(:disabled){transform:scale(1.06);box-shadow:0 4px 16px rgba(192,132,252,.4)}
#send-btn:disabled{opacity:.25;cursor:not-allowed;transform:none}
#send-btn svg{width:18px;height:18px}

.input-hint{
  font-size:11px;color:var(--t3);margin-top:8px;
  display:flex;align-items:center;gap:6px;
}
.input-hint svg{width:12px;height:12px;color:var(--success)}

/* ---- 13. Typing Indicator ---- */
.typing-indicator{display:flex;gap:5px;padding:16px 20px}
.typing-dot{
  width:7px;height:7px;border-radius:50%;background:var(--accent);
  animation:bounce 1.4s ease-in-out infinite;
}
.typing-dot:nth-child(2){animation-delay:.15s}
.typing-dot:nth-child(3){animation-delay:.3s}
@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:.35}40%{transform:translateY(-8px);opacity:1}}

/* ---- 14. Custom Scrollbar ---- */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.16)}

/* ---- 15. Focus & Accessibility ---- */
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ---- 16. Empty State ---- */
.empty-threads{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:32px 16px;color:var(--t3);font-size:12px;text-align:center;
}
.empty-threads svg{width:28px;height:28px;margin-bottom:8px;opacity:.25}

/* ---- 17. File Panel & Links ---- */
.file-link-btn {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(192, 132, 252, 0.08); border: 1px solid rgba(192, 132, 252, 0.22);
  border-radius: var(--r-md); padding: 5px 12px;
  color: var(--accent-hover); font-size: 12.5px; font-weight: 500;
  cursor: pointer; transition: all var(--dur) var(--ease);
  font-family: inherit; margin: 4px 2px; text-decoration: none;
  vertical-align: middle; box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}
.file-link-btn:hover {
  background: rgba(192, 132, 252, 0.18); border-color: rgba(192, 132, 252, 0.45);
  color: #fff; transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(192,132,252,0.15);
}
.file-link-btn svg {
  width: 15px; height: 15px; color: var(--accent); flex-shrink: 0;
  transition: color var(--dur) var(--ease);
}
.file-link-btn:hover svg { color: #fff; }

#file-panel {
  position: absolute; top: 0; right: 0; bottom: 0; width: 480px;
  min-width: 280px; max-width: 90vw; z-index: 100;
  background: var(--glass-bg-heavy); backdrop-filter: blur(var(--blur-heavy)); -webkit-backdrop-filter: blur(var(--blur-heavy));
  border-left: 1px solid var(--glass-border);
  display: flex; flex-direction: column;
  transform: translateX(0); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s var(--ease);
  box-shadow: -8px 0 32px rgba(0,0,0,0.6);
  opacity: 1; pointer-events: auto;
}
#file-panel.is-resizing {
  transition: none !important;
  user-select: none;
}
#file-panel.hidden {
  transform: translateX(100%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
  display: flex !important;
}

.file-panel-header {
  padding: 16px 20px; border-bottom: 1px solid var(--glass-border);
  display: flex; align-items: center; justify-content: space-between;
}
.file-panel-title { display: flex; align-items: center; gap: 8px; color: var(--t1); font-weight: 600; font-size: 14px; }
.file-panel-title svg { width: 16px; height: 16px; color: var(--accent); }
.file-panel-content {
  flex: 1; overflow-y: auto; padding: 0;
}

/* ---- 18. Resizer Handles ---- */
.resizer-handle {
  position: absolute; top: 0; bottom: 0; width: 6px;
  cursor: col-resize; z-index: 60;
  transition: background 0.15s ease;
}
.resizer-handle:hover, .resizer-handle.resizing {
  background: var(--accent);
}
.resizer-right { right: -3px; }
.resizer-left { left: -3px; }
.file-panel-content pre {
  margin: 0; border: none; border-radius: 0; background: transparent;
  padding: 20px; height: 100%; font-size: 12.5px; line-height: 1.6;
}

/* ---- 18. Utility ---- */
.hidden{display:none!important}
